# ==============================================================================
# CineTaste — Environment Configuration Example (.env.example)
# Copy this file to .env and fill in your values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# When true, the application runs in development UI/fallback mode using
# bundled seed data and memory storage if external services are not configured.
# Set to false in production to enforce active database validation.
APP_DEV_MODE_MOCK=true

# ------------------------------------------------------------------------------
# 2. Authentication & Session Secrets
# ------------------------------------------------------------------------------
# 32+ character high-entropy secret used for HMAC-SHA256 session signatures
SESSION_SECRET=replace_with_a_secure_random_32_char_hex_or_passphrase
# Bootstrap key used to promote or verify initial admin accounts
ADMIN_SECRET_KEY=replace_with_a_secure_admin_bootstrap_secret

# ------------------------------------------------------------------------------
# 3. Baserow Database Configuration
# Primary persistent storage for CineTaste V2.
# ------------------------------------------------------------------------------
# Baserow API root (use https://api.baserow.io or your self-hosted URL without trailing slash)
BASEROW_API_URL=https://api.baserow.io
BASEROW_API_TOKEN=your_baserow_database_token_here
BASEROW_DATABASE_ID=

# Baserow Table IDs (obtain after running baserow_prompt.txt with Kuma AI)
BASEROW_TABLE_USERS=
BASEROW_TABLE_MEDIA=
BASEROW_TABLE_USER_MEDIA=
BASEROW_TABLE_WATCH_PROVIDERS=
BASEROW_TABLE_MEDIA_WATCH_LINKS=
BASEROW_TABLE_RECOMMENDATIONS=
BASEROW_TABLE_TASTE_PROFILES=
BASEROW_TABLE_FEEDBACK=

# ------------------------------------------------------------------------------
# 4. TMDB (The Movie Database) API Configuration
# ------------------------------------------------------------------------------
TMDB_API_KEY=your_tmdb_v3_or_v4_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# ------------------------------------------------------------------------------
# 5. Gemini Web2API / OpenAI-Compatible Endpoint Configuration
# Switch between "local" and "production" via AI_ENVIRONMENT.
# ------------------------------------------------------------------------------
# Active AI environment: "local" or "production"
AI_ENVIRONMENT=local

# Local Development Endpoint (e.g., local Gemini Web2API reverse proxy)
GEMINI_LOCAL_BASE_URL=http://localhost:8000/v1
GEMINI_LOCAL_MODEL=gemini-2.5-flash
GEMINI_LOCAL_API_KEY=
GEMINI_LOCAL_TIMEOUT_MS=15000

# Production Endpoint (publicly reachable HTTPS OpenAI-compatible endpoint)
GEMINI_PROD_BASE_URL=https://api.your-gemini-provider.com/v1
GEMINI_PROD_MODEL=gemini-2.5-flash
GEMINI_PROD_API_KEY=
GEMINI_PROD_TIMEOUT_MS=20000

# Max tokens / safety request limit
GEMINI_REQUEST_LIMIT=30
