# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth
AUTH_SECRET=your_random_32_character_secret_here

# Baserow Core
BASEROW_API_URL=https://api.baserow.io
BASEROW_DATABASE_ID=486543
BASEROW_API_TOKEN=your_baserow_api_token

# Baserow Table IDs — Movies/Series/Anime
BASEROW_USERS_TABLE_ID=1063930
BASEROW_MOVIES_TABLE_ID=1063931
BASEROW_PIRATES_TABLE_ID=1063932

# Baserow Table IDs — Recommendations
BASEROW_RECOMMENDATION_PROFILE_TABLE_ID=1109815
BASEROW_RECOMMENDATION_SETS_TABLE_ID=1290945

# Baserow Table IDs — Games (DEDICATED, SEPARATE from movies)
BASEROW_GAMES_TABLE_ID=1336261
BASEROW_GAME_PIRATES_TABLE_ID=1336262

# TMDB (for movies/series/anime metadata)
TMDB_API_KEY=your_tmdb_api_key

# RAWG (for game metadata)
# Get a free API key at https://rawg.io/apidocs
# Leave blank to use curated game fallback data
RAWG_API_KEY=your_rawg_api_key

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key
GEMINI_API_BASE_URL=https://gemini-web2api-clone.vercel.app/v1
GEMINI_MODEL=gemini-3.7-flash

# Recommendation cache lifetime (in hours)
RECOMMENDATION_FRESHNESS_HOURS=72
